{
  "schema_version": "1.0.0",
  "created_at": "2026-05-19T08:42:00Z",
  "updated_at": "2026-05-19T08:42:00Z",
  "description": "Ralph-Loop configuration for safe, controlled task execution",
  "loop_constraints": {
    "max_iterations": 1,
    "max_task_attempts": 3,
    "max_fix_attempts": 1,
    "max_runtime_minutes": 30,
    "max_file_changes": 10
  },
  "execution_policy": {
    "allow_parallel": false,
    "allow_push": false,
    "allow_deploy": false,
    "allow_network": false,
    "allow_secret_access": false,
    "allow_protected_file_writes": false,
    "require_validation_before_done": true,
    "stop_on_safety_violation": true,
    "stop_on_repeated_failure_count": 3,
    "stop_on_noop_iteration": true
  },
  "human_review_policy": {
    "require_review_after_each_task": true,
    "auto_approve_documentation_only": false,
    "auto_approve_single_file_changes": false,
    "require_review_for_high_risk": true,
    "require_review_for_multiple_files": true,
    "require_review_for_architecture_changes": true
  },
  "safety_configuration": {
    "protected_file_monitoring": "enabled",
    "scope_boundary_enforcement": "strict",
    "validation_bypass_prevention": "enabled",
    "human_escalation_on_violations": "immediate"
  },
  "file_paths": {
    "morning_report_path": "reports/morning-review.md",
    "current_run_path": "runs/current-run.json",
    "task_state_path": "tasks/task-state.json",
    "latest_handoff_path": "handoffs/latest-handoff.md",
    "validation_results_path": "validation/validation-results.jsonl",
    "run_history_path": "runs/run-history.jsonl",
    "task_history_path": "tasks/task-history.jsonl"
  },
  "governance_paths": {
    "system_governance": ".governance/SYSTEM.md",
    "rules_governance": ".governance/RULES.md",
    "safety_governance": ".governance/SAFETY.md",
    "review_policy": ".governance/REVIEW_POLICY.md",
    "validation_rules": "validation/validation-rules.json"
  },
  "adapter_configuration": {
    "default_adapter": "roo",
    "available_adapters": ["roo", "cline", "opencode", "codex"],
    "adapter_selection_strategy": "task_type_based",
    "fallback_adapter": "roo"
  },
  "validation_configuration": {
    "default_validation_level": "standard",
    "require_npm_verify_for_code_changes": true,
    "require_edge_verification_for_edge_changes": true,
    "require_resolver_tests_for_resolver_changes": true,
    "validation_timeout_minutes": 10
  },
  "logging_configuration": {
    "log_all_file_changes": true,
    "log_validation_results": true,
    "log_safety_violations": true,
    "log_human_escalations": true,
    "log_adapter_selection": true
  },
  "error_handling": {
    "retry_on_transient_failures": true,
    "escalate_on_repeated_failures": true,
    "preserve_partial_work_on_failure": true,
    "document_all_failures": true
  },
  "performance_limits": {
    "max_memory_usage_mb": 2048,
    "max_disk_usage_mb": 1024,
    "max_network_requests": 0,
    "max_subprocess_count": 5
  },
  "metadata": {
    "ralph_loop_version": "0.1.0-alpha",
    "governance_compliance_version": "1.0.0",
    "configuration_format_version": "1.0.0",
    "last_review_date": "2026-05-19T08:42:00Z",
    "next_review_due": "2026-06-19T08:42:00Z",
    "notes": "Initial Ralph-Loop configuration for RALPH-003A implementation. Conservative settings for safety during initial deployment."
  }
}
