{
  "schema_version": "1.0.0",
  "created_at": "2026-05-19T08:43:00Z",
  "updated_at": "2026-05-19T08:43:00Z",
  "description": "Protected file patterns and forbidden actions for Ralph-Loop safety enforcement",
  "protected_patterns": {
    "absolute_protection": {
      "description": "Files that must never be modified by any agent under any circumstances",
      "patterns": [".env", ".env.*", "secrets/**", "credentials/**", "node_modules/**", ".git/**"]
    },
    "conditional_protection": {
      "description": "Files that require explicit human approval and task authorization",
      "patterns": [
        {
          "pattern": "package.json",
          "condition": "requires_explicit_dependency_task",
          "approval_required": true
        },
        {
          "pattern": "package-lock.json",
          "condition": "requires_explicit_dependency_task",
          "approval_required": true
        },
        {
          "pattern": "npm-shrinkwrap.json",
          "condition": "requires_explicit_dependency_task",
          "approval_required": true
        },
        {
          "pattern": "supabase/migrations/**",
          "condition": "requires_explicit_migration_task",
          "approval_required": true
        },
        {
          "pattern": ".github/workflows/**",
          "condition": "requires_explicit_cicd_task",
          "approval_required": true
        },
        {
          "pattern": "Dockerfile",
          "condition": "requires_explicit_containerization_task",
          "approval_required": true
        },
        {
          "pattern": "docker-compose.yml",
          "condition": "requires_explicit_containerization_task",
          "approval_required": true
        },
        {
          "pattern": "eas.json",
          "condition": "requires_explicit_deployment_task",
          "approval_required": true
        },
        {
          "pattern": "app.json",
          "condition": "requires_explicit_app_config_task",
          "approval_required": true
        }
      ]
    },
    "build_artifacts": {
      "description": "Generated files that should not be modified directly",
      "patterns": ["build/**", "dist/**", ".expo/**", "coverage/**", "*.log", "*.tmp"]
    }
  },
  "approval_required_patterns": {
    "description": "File patterns that always require human approval before modification",
    "patterns": [
      "package.json",
      "package-lock.json",
      "supabase/migrations/**",
      ".github/**",
      "eas.json",
      "app.json",
      "babel.config.js",
      "metro.config.js",
      "jest.config.js",
      ".eslintrc.*",
      ".prettierrc*",
      "tsconfig.json"
    ]
  },
  "forbidden_actions": {
    "never_allowed": {
      "description": "Actions that are strictly forbidden for all agents",
      "actions": [
        "push",
        "deploy",
        "production_side_effects",
        "secret_printing",
        "destructive_delete",
        "dependency_install",
        "auth_config_change",
        "billing_config_change",
        "git_history_modification",
        "environment_variable_modification"
      ]
    },
    "approval_required": {
      "description": "Actions that require explicit human approval",
      "actions": [
        "database_migration",
        "schema_change",
        "dependency_update",
        "configuration_change",
        "deployment_script_modification",
        "ci_cd_modification",
        "security_config_change",
        "performance_config_change"
      ]
    }
  },
  "safety_enforcement": {
    "monitoring": {
      "real_time_file_monitoring": true,
      "pre_commit_hook_enforcement": true,
      "automated_scanning": true,
      "violation_logging": true
    },
    "response": {
      "immediate_block": true,
      "detailed_logging": true,
      "human_notification": true,
      "automatic_rollback": true
    },
    "escalation": {
      "violation_analysis": true,
      "policy_update_consideration": true,
      "agent_behavior_adjustment": true,
      "process_improvement": true
    }
  },
  "exception_handling": {
    "emergency_override": {
      "allowed": false,
      "requires_multiple_approvals": true,
      "full_audit_trail_required": true,
      "post_incident_review_required": true
    },
    "temporary_exceptions": {
      "allowed": true,
      "max_duration_hours": 24,
      "requires_explicit_approval": true,
      "requires_justification": true,
      "automatic_expiration": true
    }
  },
  "validation_integration": {
    "pre_modification_checks": [
      "protected_pattern_scan",
      "approval_requirement_check",
      "forbidden_action_detection",
      "scope_boundary_validation"
    ],
    "post_modification_checks": [
      "change_scope_verification",
      "protection_violation_scan",
      "approval_compliance_check",
      "safety_policy_compliance"
    ]
  },
  "reporting": {
    "violation_reports": {
      "enabled": true,
      "include_stack_trace": true,
      "include_context": true,
      "include_remediation_suggestions": true
    },
    "compliance_reports": {
      "enabled": true,
      "frequency": "daily",
      "include_metrics": true,
      "include_trends": true
    },
    "audit_trail": {
      "enabled": true,
      "retention_days": 90,
      "include_all_access_attempts": true,
      "include_approval_decisions": true
    }
  },
  "integration": {
    "governance_compliance": {
      "system_governance": ".governance/SYSTEM.md",
      "safety_governance": ".governance/SAFETY.md",
      "validation_rules": "validation/validation-rules.json"
    },
    "adapter_integration": {
      "all_adapters_must_comply": true,
      "adapter_specific_overrides": false,
      "consistent_enforcement": true
    }
  },
  "metadata": {
    "ralph_loop_version": "0.1.0-alpha",
    "safety_policy_version": "1.0.0",
    "last_review_date": "2026-05-19T08:43:00Z",
    "next_review_due": "2026-06-19T08:43:00Z",
    "compliance_standard": "Ralph-Loop Safety Standard v1.0",
    "notes": "Initial protected files configuration for RALPH-003A. Conservative protection patterns for safe Ralph-Loop deployment."
  }
}
