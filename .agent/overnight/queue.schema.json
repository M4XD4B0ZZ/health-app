{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthapp.local/schemas/ralph-overnight-queue.schema.json",
  "title": "RALPH Overnight Worker v1 Dry-Run Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "queue_id", "created_at", "created_by", "mode", "tasks"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "queue_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "created_by": { "type": "string", "minLength": 1 },
    "mode": { "const": "dry_run" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "class",
        "objective",
        "allowed_files",
        "forbidden_files",
        "max_files_changed",
        "max_diff_lines",
        "allowed_commands",
        "forbidden_commands",
        "required_checks",
        "timeout_minutes",
        "max_attempts",
        "commit_policy",
        "push_policy",
        "stop_conditions",
        "expected_outputs",
        "handoff_required",
        "review_required",
        "notes"
      ],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "class": { "enum": ["SAFE_AUTONOMOUS", "REVIEW_REQUIRED", "HUMAN_ONLY", "FORBIDDEN"] },
        "objective": { "type": "string", "minLength": 1 },
        "allowed_files": { "$ref": "#/$defs/stringArray" },
        "forbidden_files": { "$ref": "#/$defs/stringArray" },
        "max_files_changed": { "type": "integer", "minimum": 0 },
        "max_diff_lines": { "type": "integer", "minimum": 0 },
        "allowed_commands": { "$ref": "#/$defs/stringArray" },
        "forbidden_commands": { "$ref": "#/$defs/stringArray" },
        "required_checks": { "$ref": "#/$defs/stringArray" },
        "timeout_minutes": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 0 },
        "commit_policy": { "const": "never" },
        "push_policy": { "const": "never" },
        "stop_conditions": { "$ref": "#/$defs/stringArray" },
        "expected_outputs": { "type": "array", "items": { "type": "string" } },
        "handoff_required": { "type": "boolean" },
        "review_required": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
