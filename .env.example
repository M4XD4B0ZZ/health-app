# Supabase MCP server (.mcp.json) — not used by the app itself, only by the
# Supabase MCP server config. Get these from the Supabase dashboard:
# https://supabase.com/dashboard/account/tokens (personal access token)
# and Project Settings > General (project ref / "Reference ID").
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
