# Supabase / Database
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_RESOLVER_DEBUG=
EXPO_PUBLIC_SHOW_TODAYS_ENTRIES=
