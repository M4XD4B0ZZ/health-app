{
  "name": "health-dashboard",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "typecheck:functions": "deno check supabase/functions/food-usda-search/index.ts supabase/functions/food-off-search/index.ts supabase/functions/_shared/food-cache.ts",
    "typecheck:all": "npm run typecheck && npm run typecheck:functions",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "verify:supabase:link": "node --env-file=.env scripts/verify-supabase-project.mjs",
    "verify:schema": "node --env-file=.env scripts/verify-remote-schema.mjs",
    "verify:edge": "node --env-file=.env scripts/verify-edge-functions.mjs",
    "benchmark:ai-reranking": "node --env-file=.env scripts/benchmark-ai-reranking-providers.mjs",
    "supabase:link": "npx supabase link --project-ref kbplfcqluqqowmvchvhc",
    "deploy:edge": "npx supabase functions deploy food-off-search --no-verify-jwt && npx supabase functions deploy food-usda-search --no-verify-jwt",
    "deploy:edge:verify": "npm run deploy:edge && npm run verify:edge",
    "doctor": "node scripts/doctor.mjs",
    "agent:next": "node scripts/agent/select-next-task.mjs",
    "agent:prompt": "node scripts/agent/build-roo-prompt.mjs",
    "agent:verify": "node scripts/agent/run-verify.mjs",
    "agent:handoff": "node scripts/agent/write-handoff-template.mjs",
    "agent:run": "node scripts/agent/run-agent-loop.mjs",
    "agent:worker": "node scripts/agent/run-opencode-worker.mjs",
    "agent:worker:debug": "node scripts/agent/run-opencode-worker.mjs --debug",
    "agent:worker:matrix": "node scripts/agent/run-opencode-worker.mjs --matrix",
    "agent:worker-prompt": "node scripts/agent/build-worker-prompt.mjs",
    "agent:model": "node scripts/agent/select-model.mjs",
    "agent:auto": "node scripts/agent/run-auto-task.mjs",
    "agent:milestone": "node scripts/agent/run-milestone.mjs",
    "agent:watch": "node scripts/agent/watch-agent.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "@supabase/supabase-js": "^2.95.3",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.36",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.2.3",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "prettier": "^3.6.2",
    "read-excel-file": "^9.2.0",
    "supabase": "^2.76.11",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
