    {
      "alternative": "Source-ID-only exception (INCOMPATIBLE_GENERIC_QUERIES_BY_SOURCE_ID) for X5A1030",
      "reason": "Insufficiently general -- the audit independently found 10 further real BLS records with the identical defect class, which a per-sourceId list would have missed entirely."
    },
    {
      "alternative": "Globally disabling substring matching in BlsLookupEngine",
      "reason": "Would discard the entire safe sub_token_substring_query_specific direction (380 queries in the audited population, including RESOLVER-V2-010's approved Speck sub-terms) for a defect that only manifested in 11 of 13,055 queries -- disproportionate, unmeasured blast radius."
    },
    {
      "alternative": "Blanket compound-word-never-accept rule at the BlsLookupEngine search stage",
      "reason": "Conflates discoverability with identity confidence; removes candidates from retrieval entirely, losing ranking/discovery value."
    }
  ],
