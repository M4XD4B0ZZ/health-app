  "rootCause": {
    "primaryMechanism": "BlsLookupEngine.calculateTokenScore (Stage 4, findTokenMatches): symmetric substring partial-match credit (0.8) for either direction (recordToken.includes(inputToken) or inputToken.includes(recordToken)), with no distinction between a compound query matching a shorter generic record (safe) and a generic query fused inside a more specific compound record token (unsafe).",
    "secondaryMechanism": "BlsLookupEngine.findIncludesMatches (Stage 2/3/5): alias-substring containment carries the identical risk one stage later; confirmed a Stage-4-only fix would not have closed the defect (fallback score ~0.786, still above the 0.75 accept threshold).",
    "thresholdBypassGap": "SequentialFoodCatalogResolver's dedicated BLS generic-truth early-return gate uses a higher accept threshold (0.85 for inputType 'ambiguous') than the generic multi-source fallback decision it falls through to (0.75, ResolverDecisionPolicy.ACCEPT_THRESHOLD) -- a fix applied only inside the gate is bypassable for scores in [0.75, 0.85) on 'ambiguous'-classified queries. Confirmed via detectInputType('Ein Snack') === 'ambiguous' and the benchmark fast-path adapter. Fixed by applying the guard at both sites via a shared helper."
  },
  "substringTaxonomy": [
    "exact_identity",
    "whole_token",
    "sub_token_substring_record_specific",
    "sub_token_substring_query_specific",
    "alias_substring",
    "no_relation",
    "no_candidates"
  ],
  "selectedPolicy": {
    "name": "hasBlsGenericSubstringOnlyIdentity",
    "location": "src/features/nutrition/infrastructure/catalog/sources/bls/BlsLookupEngine.ts",
    "appliedVia": "guardAgainstBlsGenericSubstringCollision (SequentialFoodCatalogResolver.ts), applied at both the BLS generic-truth fast-path gate and the generic multi-source fallback decision",
    "description": "A BLS candidate is disqualified from confident acceptance when: (1) it has no genuine exact/whole-alias identity for the query (match.exact === false), AND (2) the query is not a whole-token match against the candidate's own normalizedName (every query token present as a complete, space-delimited token), AND (3) the query is still a strict substring fragment of the candidate's (whitespace-collapsed) normalizedName. Retrieval/ranking untouched; only confident acceptance is blocked, downgraded to an honest ambiguous decision with reasonCode BLS_GENERIC_SUBSTRING_COLLISION_RISK, best/secondBest cleared, candidates preserved.",
    "generalizedNotCaseSpecific": true,
    "noHandCuratedWordList": true,
    "noPostHocScoreThreshold": true,
    "noSourceIdOnlyException": true
  },
  "rejectedAlternatives": [
    {
